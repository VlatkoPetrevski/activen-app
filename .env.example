# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/activen_dev
DATABASE_POOL_MAX=10
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
# Integration tests create a throw-away database on this server:
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# --- Sign-in (ADR-0010) ---
PUBLIC_WEB_URL=http://localhost:5173
# Ed25519 private JWK; required in production. Generate with:
#   node -e "import('jose').then(async j=>{const k=await j.generateKeyPair('EdDSA',{crv:'Ed25519',extractable:true});console.log(JSON.stringify({...await j.exportJWK(k.privateKey),kid:'key-1'}))})"
AUTH_SIGNING_KEY=
AUTH_ISSUER=https://api.activen.mk
ACCESS_TOKEN_TTL_SECONDS=900
# Comma-separated OAuth client IDs; empty disables the provider.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
EMAIL_TRANSPORT=log
# Rate limits (requests per minute per client IP) and proxy hops in front of the API.
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=20
TRUST_PROXY_HOPS=0

# --- Web app (apps/web, read at build time) ---
# VITE_API_URL=            # empty = same origin (reverse proxy /v1 to the API)
# VITE_GOOGLE_CLIENT_ID=   # Google OAuth web client ID (also in GOOGLE_CLIENT_IDS)
# VITE_APPLE_CLIENT_ID=    # Apple Services ID (also in APPLE_CLIENT_IDS)
