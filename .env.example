# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/activen_dev
DATABASE_POOL_MAX=10
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
# Integration tests create a throw-away database on this server:
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# --- Sign-in (ADR-0010) ---
PUBLIC_WEB_URL=http://localhost:5173
# Ed25519 private JWK; required in production. Generate with:
#   node -e "import('jose').then(async j=>{const k=await j.generateKeyPair('EdDSA',{crv:'Ed25519',extractable:true});console.log(JSON.stringify({...await j.exportJWK(k.privateKey),kid:'key-1'}))})"
AUTH_SIGNING_KEY=
AUTH_ISSUER=https://api.activen.app
ACCESS_TOKEN_TTL_SECONDS=900
# Comma-separated OAuth client IDs; empty disables the provider.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
EMAIL_TRANSPORT=log
# smtp: sends for real. Zoho Mail: smtp.zoho.eu, 465, the mailbox user and an app password
# (Zoho › Security › App passwords). EMAIL_FROM must be that mailbox or one of its aliases.
# SMTP_HOST=smtp.zoho.eu
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=ActiveN <info@activen.app>
# Morning briefing emails: how often due athletes are looked up (0 = off).
BRIEFING_REMINDER_INTERVAL_SECONDS=300
# Rate limits (requests per minute per client IP) and proxy hops in front of the API.
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=20
TRUST_PROXY_HOPS=0

# --- Web app (apps/web, read at build time) ---
# VITE_API_URL=            # empty = same origin (reverse proxy /v1 to the API)
# VITE_GOOGLE_CLIENT_ID=   # Google OAuth web client ID (also in GOOGLE_CLIENT_IDS)
# VITE_APPLE_CLIENT_ID=    # Apple Services ID (also in APPLE_CLIENT_IDS)

# Optional: AI for "Структурирај" (workout text → steps). Without these only the parser runs.
# ACTIVEN_AI_API_KEY=
# ACTIVEN_AI_MODEL=

# --- Production (domain: activen.app) ---
# PUBLIC_WEB_URL=https://activen.app
# CORS_ORIGINS=https://activen.app
# AUTH_ISSUER=https://api.activen.app
# APPLE_CLIENT_IDS=app.activen.web      # Apple Services ID (reverse domain)
# Google OAuth: authorised JavaScript origin https://activen.app

# --- Activity sources (ADR-0012) ---
# Original uploaded files (FIT/GPX/TCX); persistent storage in production.
# ACTIVEN_FILE_STORE_DIR=.data/files
# IMPORT_RATE_LIMIT_PER_MINUTE=30
# Vendor connections: 32-byte base64 key for token encryption and OAuth state.
# ACTIVEN_TOKEN_KEY=
# PUBLIC_API_URL=https://api.activen.app
# Polar AccessLink client (admin.polaraccesslink.com) and webhook secret.
# POLAR_CLIENT_ID=
# POLAR_CLIENT_SECRET=
# POLAR_WEBHOOK_SECRET=
# SYNC_INTERVAL_SECONDS=60
