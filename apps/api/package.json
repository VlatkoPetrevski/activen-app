{
  "name": "@activen/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ActiveN HTTP API (NestJS modular monolith)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@activen/db": "workspace:*",
