{
  "name": "@activen/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL schema (Drizzle), migrations and repositories mapping rows to the ActiveN domain model",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/migrate-cli.js"
  },
  "dependencies": {
    "@activen/domain": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
