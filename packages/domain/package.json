{
  "name": "@activen/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure, framework-free business rules: HR zones, pace, summaries, plan matching, vendor-agnostic activity model",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage"
  }
}
