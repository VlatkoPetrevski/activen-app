{
  "name": "@activen/importers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Activity files (FIT, GPX, TCX) to the canonical model: summary, laps, samples, device. Pure, no I/O.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@activen/domain": "workspace:*",
    "@garmin/fitsdk": "^21.222.0",
    "fast-xml-parser": "^5.12.1"
  }
}
